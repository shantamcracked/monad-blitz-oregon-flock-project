# Copy to .env.local for local dev. Add the same keys in Vercel → Project → Settings → Environment Variables.
# ── public (safe in browser) ──
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_MONAD_RPC_URL=https://testnet-rpc.monad.xyz
NEXT_PUBLIC_EXPLORER_URL=https://testnet.monadexplorer.com
NEXT_PUBLIC_APP_URL=https://YOUR-APP.vercel.app
# ── server only (NEVER prefix with NEXT_PUBLIC_) ──
DEPLOYER_PRIVATE_KEY=
RELAYER_PRIVATE_KEYS=
MONAD_RPC_URL_SERVER=
ADMIN_SECRET=pick-a-random-word
